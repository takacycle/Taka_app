# Exposed to the browser (Supabase publishable key is safe to ship — access is
# controlled by Row Level Security policies, not by keeping this secret).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Maps JavaScript API only, restricted in Google Cloud by HTTP referrer (this app's
# domain). Safe to expose client-side — that's how the Maps JS SDK is designed to work.
NEXT_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# From Supabase dashboard → Settings → API Keys → Secret key (sb_secret_...). Server-only,
# never exposed to the browser, used by API routes/server actions.
SUPABASE_SECRET_KEY=

# The Directions/Distance Matrix/Geocoding key used for the actual nearest-agent
# dispatch + ETA logic lives in Supabase Edge Function secrets (`supabase secrets set`),
# not here — it must never ship in a client bundle, mobile or web.
