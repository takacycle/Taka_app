# Exposed to the JS bundle at runtime (Supabase publishable key is safe to ship — access
# is controlled by Row Level Security policies, not by keeping this secret).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Read only by app.config.ts at build time, baked into native config — never bundled
# into JS, so no EXPO_PUBLIC_ prefix. Each restricted in Google Cloud to Maps SDK for
# that platform + this app's bundle ID / package + SHA-1.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
